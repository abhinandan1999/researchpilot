# ============================================================
# ResearchPilot environment configuration (example)
# Copy to .env and fill in your own values.
# ============================================================

# --- LLM provider ---
# LLM_PROVIDER: ollama (default, local, no API key/cost) | openai
LLM_PROVIDER=ollama

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Requires Ollama running locally: https://ollama.com
#   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (only required when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Langfuse (optional; app runs without it) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# When false, the raw user question is NOT sent to Langfuse.
# Only safe metadata (question_length, question_hash) is captured.
LANGFUSE_CAPTURE_INPUT=false

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Timeouts (seconds) ---
TOOL_TIMEOUT_SECONDS=10
# 60s default gives local Ollama inference room (first call after a cold
# model load is slower); lower this if using OpenAI.
LLM_TIMEOUT_SECONDS=60

# --- Retries / loops ---
MAX_RETRIES=2
MAX_RESEARCH_ITERATIONS=2

# --- Limits ---
MAX_QUESTION_LENGTH=4000

# --- Demo / workshop scenarios ---
# DEMO_SCENARIO one of:
#   normal | slow_search | search_failure | search_retry | expensive_agent
#   | agent_loop | parallel_research | low_groundedness
DEMO_MODE=true
DEMO_SCENARIO=normal

# --- Backend URL used by the Streamlit frontend ---
BACKEND_URL=http://localhost:8000
